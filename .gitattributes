# Shell-скрипты собираются и запускаются в Linux (в т.ч. в WSL через /mnt/c).
# Перевод строк обязан остаться LF: при core.autocrlf=true Windows-чекаут иначе
# превратил бы их в CRLF, и bash падал бы на каждом переводе строки
# ("$'\r': command not found"). Правило узкое — остальные файлы не трогаем.
*.sh text eol=lf
