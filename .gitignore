# Godot cache (генерируется при импорте/экспорте)
.godot/
.godot/**
# Godot 3 кэширует импорт в .import/ (в Godot 4 это .godot/)
.import/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Worker build artifacts (собирается PyInstaller'ом)
v2/gui/bundled/
v2/dist/
v2/build/
v2/*.spec
v2/wg_worker.exe
v2/WG_Vanity_v2.exe
v2/export/
v3/gui/bundled/
v3/dist/
v3/build/
v3/*.spec
v3/wg_worker.exe
v3/WG_Vanity_v3.exe
v3/export/
v3/rcedit-x64.exe
v3/export_log.txt

# Нативный движок (onion v3 + WireGuard): кэши zig (сборочный мусор build.ps1)
.zig-cache/
.zig-global-cache/
*.zig-cache/
*.zig-global-cache/
v3/core/vanity_native/.zig-cache/
v3/core/vanity_native/.zig-global-cache/
# ...а сам bin/vanity_core.dll, наоборот, КОММИТИТСЯ (на машинах сборки нет
# компилятора, без него релиз не воспроизвести) — см. v3/core/vanity_native/build.ps1
v3/core/vanity_native/bin/*.lib
v3/core/vanity_native/bin/*.pdb
v3/core/vanity_native/bin/*.exp

# Локальные черновики замеров
v3/bench/*.json
v3/bench/*.log

# Secrets & локальные результаты (не коммитим)
wg_keys_log.txt
outtest/
export/
*token*
*.conf
*.keys.txt
*.qr.png
